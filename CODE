import java.util.Scanner;

public class VendingMachine {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        // Product details
        String[] products = {
            "Chips",
            "Chocolate",
            "Juice",
            "Biscuit"
        };

        int[] prices = {
            20,
            30,
            40,
            25
        };

        int[] stock = {
            5,
            3,
            4,
            6
        };

        // Display products 
        System.out.println("===== VENDING MACHINE =====");

        for (int i = 0; i < products.length; i++) {
            System.out.println(
                (i + 1) + ". " +
                products[i] +
                " - Rs." + prices[i] +
                " - Stock: " + stock[i]
            );
        }

        // Select product
        System.out.print("\nEnter product code: ");
        int choice = sc.nextInt();

        int price = 0;

        // Product selection using switch
        switch (choice) {

            case 1:
                price = 20;
                System.out.println("You selected Chips");
                break;

            case 2:
                price = 30;
                System.out.println("You selected Chocolate");
                break;

            case 3:
                price = 40;
                System.out.println("You selected Juice");
                break;

            case 4:
                price = 25;
                System.out.println("You selected Biscuit");
                break;

            default:
                System.out.println("Invalid product code!");
                sc.close();
                return;
        }

        // Check stock
        if (stock[choice - 1] <= 0) {
            System.out.println("Sorry, product is out of stock.");
            sc.close();
            return;
        } else {
            System.out.println("Product is available.");
        }

        System.out.println("Price: Rs." + price);

        // Accept money
        int money = 0;

        while (money < price) {

            System.out.print("Insert money: ");
            int coin = sc.nextInt();

            money = money + coin;

            System.out.println(
                "Money inserted: Rs." + money
            );

            if (money < price) {
                System.out.println(
                    "Insufficient money. Insert more."
                );
            }
        }

        // Payment successful
        if (money >= price) {

            int change = money - price;

            System.out.println("\nPayment successful!");
            System.out.println("Change returned: Rs." + change);

            // Dispense product
            System.out.println(
                "Dispensing " + products[choice - 1] + "..."
            );

            stock[choice - 1]--;

            System.out.println("Please collect your product.");
            System.out.println("Thank you for using the vending machine!");
            
        }

        sc.close();                                                                                              
    }
}
